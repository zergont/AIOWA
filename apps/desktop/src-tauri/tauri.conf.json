{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIOWA",
  "version": "0.2.0",
  "identifier": "ru.aiowa.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "AIOWA",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://aiowa-att.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://aiowa-att.localhost",
        "frame-src": "'self' http://aiowa-att.localhost",
        "media-src": "'self' http://aiowa-att.localhost",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "AIOWA",
    "copyright": "© 2026 AIOWA",
    "category": "Productivity",
    "shortDescription": "Почта и календарь Exchange через Outlook Web Access",
    "longDescription": "Настольный клиент Exchange 2019 через OWA: офлайн-база писем с поиском, вложения, ответы и пересылка, календарь и встречи, адресная книга организации, мгновенные уведомления.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQkMwOTVBMUExOTZFNDkKUldSSmJoa2FXZ204VFVhWmY2L0k5ZytVZGRUaW5kdzQvUDVrUnpBMjNNY0RWS0YzV3Q1eHZJL2cK",
      "endpoints": [
        "https://github.com/zergont/AIOWA/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
