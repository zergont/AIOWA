{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows",
  "description": "отдельные окна (docs/obkatka.md пп. 31–32): просмотр вложений, письмо, черновик — своё окно без системной рамки: перетаскивание, кнопки окна, заголовок и тема",
  "windows": [
    "att-*",
    "msg-*",
    "cmp-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
